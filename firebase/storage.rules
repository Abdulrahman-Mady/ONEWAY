rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function underTenMb() { return request.resource.size < 10 * 1024 * 1024; }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId && isImage() && underTenMb();
    }
    match /reports/{userId}/{reportId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId && isImage() && underTenMb();
    }
    match /places/{placeId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
